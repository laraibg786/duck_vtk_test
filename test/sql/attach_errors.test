# name: test/sql/attach_errors.test
# description: every bad input fails with an actionable message, never a crash
# group: [vtk]

require vtk

statement error
ATTACH 'test/data/does_not_exist.vtk' AS m (TYPE vtk);
----
no such file

# A truncated file must NOT be mistaken for valid or empty data. VTK gives no
# error code for this — detection relies on capturing its output window.
statement error
ATTACH 'test/data/synthetic/truncated.vtk' AS m (TYPE vtk);
----
corrupt or truncated

# Dispatch is on CONTENT, never on the file extension.
statement error
ATTACH 'test/data/synthetic/not_really.vtk' AS m (TYPE vtk);
----
duck_vtk: cannot read

statement error
ATTACH 'test/data/synthetic/bad_type.vtu' AS m (TYPE vtk);
----
duck_vtk: cannot read

# An XML file that fails to parse must FAIL, not produce an empty mesh.
#
#   REGRESSION TEST. VTK reports GetErrorCode() == Success for a failed XML parse
#   and hands back a valid but empty dataset, so this used to attach cleanly and
#   report a mesh with 0 points and 0 cells. Found on Ubuntu 24.04's VTK 9.1, where
#   EVERY file with an <AppendedData> section hits this path — cow.vtp read as 0
#   points instead of 2903. The fixture reproduces it on any VTK version by putting
#   junk after the root element, which is what 9.1 believes it is seeing.
#
#   Fixed by adding the XML parse failures to FATAL_SUBSTRINGS in
#   src/vtk/vtk_error_scope.cpp. The output-window check, not GetErrorCode(), is
#   what catches this — the same reason the truncated-legacy-file check exists.
statement error
ATTACH 'test/data/synthetic/bad_xml_junk.vtu' AS m (TYPE vtk);
----
junk after document element

# Unknown options are rejected so adding real ones later is not a silent change.
statement error
ATTACH 'test/data/legacy/uGridEx.vtk' AS m (TYPE vtk, bogus_option 'x');
----
unknown ATTACH option

# A write-mode request that cannot be honoured is refused rather than ignored.
statement error
ATTACH 'test/data/legacy/uGridEx.vtk' AS m (TYPE vtk, READ_WRITE);
----
read-only
