# name: test/sql/read_only.test
# description: every write path refuses cleanly. An unimplemented pure virtual
#              that CRASHES instead of throwing is the most likely serious bug in
#              the catalog layer, so each override gets its own assertion.
# group: [vtk]

require vtk

statement ok
ATTACH 'test/data/legacy/uGridEx.vtk' AS m (TYPE vtk);

statement error
CREATE TABLE m.foo(i INTEGER);
----
read-only

statement error
CREATE VIEW m.v AS SELECT 1;
----
read-only

statement error
CREATE SCHEMA m.other;
----
read-only

statement error
DROP TABLE m.points;
----
read-only

statement error
ALTER TABLE m.points RENAME TO renamed;
----
read-only

# The two supported DuckDB lines refuse this at different depths, so the assertion
# is on the substring common to both messages:
#   1.4.5 -> reaches VtkCatalog::BindCreateIndex: "... an index on a read-only VTK database"
#   1.5.4 -> rejected earlier by the binder:      "... an index on a base table"
# Before BindCreateIndex was overridden, 1.4.5 CRASHED here with
# "INTERNAL Error: Attempting to dereference an optional pointer that is not set".
# Design §7 requires a clean refusal, not a particular message.
statement error
CREATE INDEX idx ON m.points(point_id);
----
index on a

statement error
CREATE SEQUENCE m.seq;
----
read-only

statement error
CREATE TYPE m.t AS ENUM ('a');
----
read-only

statement error
INSERT INTO m.points VALUES (99, 0, 0, 0, 0, [0,0,0]);
----
read-only VTK database

statement error
CREATE TABLE m.ctas AS SELECT * FROM m.points;
----
read-only

# Reads must still work after all those refusals — no state was corrupted.
query I
SELECT count(*) FROM m.points;
----
27
